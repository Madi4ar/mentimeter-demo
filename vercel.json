{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/player.html" },
    { "source": "/host", "destination": "/host.html" }
  ],
  "functions": { "api/**/*.js": { "maxDuration": 15 } }
}
